{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "MongoDb": "mongodb://localhost:27017"
  },
  "MongoDb": {
    "Database": "petcore",
    "HistoricosCollection": "historicos"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Args": {
          "retainedFileCountLimit": 14,
          "rollingInterval": "Day",
          "path": "logs/petcore-.log"
        },
        "Name": "File"
      }
    ]
  },
  "ExternalServices": {
    "BaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "*"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Audience": "PetCore.Client",
    "Issuer": "PetCore"
  }
}
